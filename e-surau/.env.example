# Supabase - dapatkan dari Project Settings > API di dashboard Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Kunci service_role (RAHSIA - untuk operasi admin sahaja, jangan dedah ke client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Zon waktu solat JAKIM (SGR01 = Selangor termasuk Semenyih/Hulu Langat)
NEXT_PUBLIC_ZON_SOLAT=SGR01

# Nama surau (papar di laman awam) — sudah ditetapkan lalai dalam kod juga
NEXT_PUBLIC_NAMA_SURAU=Surau Ar Raudhah, Eco Majestic Semenyih
